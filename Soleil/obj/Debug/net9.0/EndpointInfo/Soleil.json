        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EyeScanRequestDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/EyeScanRequestDto"
              }
            },
            "application/*+json": {
