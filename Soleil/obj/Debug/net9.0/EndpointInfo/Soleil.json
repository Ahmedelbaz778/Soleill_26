        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Account/register-doctor": {
      "post": {
        "tags": [
          "Account"
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "required": [
                  "City",
                  "Education",
                  "Email",
                  "ExperienceYears",
                  "FirstName",
                  "LastName",
                  "NationalId",
                  "Password",
                  "Street"
                ],
                "type": "object",
                "properties": {
                  "FirstName": {
                    "type": "string"
                  },
                  "LastName": {
                    "type": "string"
                  },
                  "Email": {
                    "type": "string",
                    "format": "email"
                  },
                  "Password": {
                    "minLength": 6,
                    "type": "string"
                  },
                  "Education": {
                    "type": "string"
                  },
                  "ExperienceYears": {
                    "type": "integer",
                    "format": "int32"
                  },
                  "NationalId": {
                    "type": "string"
                  },
                  "City": {
                    "type": "string"
                  },
                  "Street": {
                    "type": "string"
                  },
                  "Building": {
                    "type": "string"
                  },
                  "ClinicPhone": {
                    "type": "string"
                  },
                  "WorkingHours": {
                    "type": "string"
                  },
                  "CertificateImage": {
                    "type": "string",
                    "format": "binary"
                  }
                }
              },
              "encoding": {
                "FirstName": {
                  "style": "form"
                },
                "LastName": {
                  "style": "form"
                },
                "Email": {
                  "style": "form"
                },
                "Password": {
                  "style": "form"
                },
                "Education": {
                  "style": "form"
                },
                "ExperienceYears": {
                  "style": "form"
                },
                "NationalId": {
                  "style": "form"
                },
                "City": {
                  "style": "form"
                },
                "Street": {
                  "style": "form"
                },
                "Building": {
                  "style": "form"
                },
                "ClinicPhone": {
                  "style": "form"
                },
                "WorkingHours": {
                  "style": "form"
                },
                "CertificateImage": {
                  "style": "form"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
